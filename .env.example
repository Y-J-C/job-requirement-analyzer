APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3001

POSTGRES_USER=job_analyzer
POSTGRES_PASSWORD=job_analyzer_local
POSTGRES_DB=job_analyzer
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://job_analyzer:job_analyzer_local@localhost:5432/job_analyzer

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

MINIO_ROOT_USER=job_analyzer
MINIO_ROOT_PASSWORD=job_analyzer_local
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT_URL=http://localhost:19000
S3_BUCKET=job-source-files
S3_REGION=us-east-1
S3_ACCESS_KEY=job_analyzer
S3_SECRET_KEY=job_analyzer_local
UPLOAD_MAX_BYTES=10485760
IMAGE_MAX_FILES=10
IMAGE_TOTAL_MAX_BYTES=52428800
IMAGE_MAX_PIXELS=40000000
IMAGE_TOTAL_MAX_PIXELS=120000000
PDF_MAX_PAGES=50
PDF_RENDER_SCALE=2
PDF_OCR_MAX_PAGE_PIXELS=20000000
PDF_OCR_MAX_TOTAL_PIXELS=120000000
EXTRACTED_TEXT_MAX_CHARS=100000
DOCUMENT_WORKER_LEASE_SECONDS=120
DOCUMENT_WORKER_MAX_ATTEMPTS=3
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
CLAMAV_TIMEOUT_SECONDS=30

# Rotate exposed credentials before use. Keep real values only in the ignored .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_OUTPUT_RETRIES=1
DEEPSEEK_MAX_INPUT_CHARS=30000

ANALYSIS_WORKER_POLL_SECONDS=1
ANALYSIS_WORKER_LEASE_SECONDS=600
ANALYSIS_WORKER_MAX_ATTEMPTS=3
ANALYSIS_WORKER_RETRY_DELAY_SECONDS=5
