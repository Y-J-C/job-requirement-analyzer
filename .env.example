APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

POSTGRES_USER=job_analyzer
POSTGRES_PASSWORD=job_analyzer_local
POSTGRES_DB=job_analyzer
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://job_analyzer:job_analyzer_local@localhost:5432/job_analyzer

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Rotate exposed credentials before use. Keep real values only in the ignored .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_OUTPUT_RETRIES=1
DEEPSEEK_MAX_INPUT_CHARS=30000

ANALYSIS_WORKER_POLL_SECONDS=1
ANALYSIS_WORKER_LEASE_SECONDS=600
ANALYSIS_WORKER_MAX_ATTEMPTS=3
ANALYSIS_WORKER_RETRY_DELAY_SECONDS=5
