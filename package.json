{
  "name": "job-requirement-analyzer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "concurrently --names web,api,worker --prefix-colors blue,green,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:e2e": "concurrently --kill-others-on-fail --names web,api,worker --prefix-colors blue,green,yellow \"pnpm dev:web\" \"pnpm dev:api:e2e\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir apps/api --reload --host 127.0.0.1 --port 8000",
    "dev:api:e2e": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 18000",
    "dev:worker": ".\\.venv\\Scripts\\python.exe -m app.worker",
    "worker:once": ".\\.venv\\Scripts\\python.exe -m app.worker --once",
    "lint": "pnpm lint:web && pnpm lint:api",
    "lint:web": "pnpm --dir apps/web lint",
    "lint:api": ".\\.venv\\Scripts\\python.exe -m ruff check apps/api",
    "typecheck": "pnpm --dir apps/web typecheck",
    "test": "pnpm test:web && pnpm test:api",
    "test:ai:quality": ".\\.venv\\Scripts\\python.exe -m pytest apps/api/tests/test_ai_evaluation.py apps/api/tests/test_ai_evaluation_cli.py apps/api/tests/test_deepseek_analyzer.py apps/api/tests/test_ai_analysis.py",
    "eval:ai:deepseek": ".\\.venv\\Scripts\\python.exe -m app.ai.evaluate_deepseek",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e2e.ps1",
    "test:e2e:deepseek": "cross-env RUN_DEEPSEEK_E2E=1 powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e2e.ps1 --grep \"@deepseek\"",
    "test:web": "pnpm --dir apps/web test",
    "test:api": ".\\.venv\\Scripts\\python.exe -m pytest apps/api/tests",
    "test:api:integration": "cross-env RUN_DATABASE_TESTS=1 RUN_STORAGE_TESTS=1 .\\.venv\\Scripts\\python.exe -m pytest apps/api/tests/integration/test_document_pipeline.py",
    "test:api:security-integration": "cross-env RUN_MALWARE_TESTS=1 .\\.venv\\Scripts\\python.exe -m pytest apps/api/tests/integration/test_clamav_scanning.py",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "pnpm --dir apps/web build",
    "build:api": ".\\.venv\\Scripts\\python.exe -m compileall -q apps/api/app",
    "db:up": "docker compose up -d postgres minio clamav",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres minio clamav",
    "api:migrate": ".\\.venv\\Scripts\\python.exe -m alembic -c apps/api/alembic.ini upgrade head",
    "api:contract:export": ".\\.venv\\Scripts\\python.exe apps/api/scripts/export_openapi.py packages/api-contract/openapi.json",
    "api:contract:generate": "pnpm api:contract:export && pnpm --dir apps/web exec openapi-typescript ../../packages/api-contract/openapi.json -o src/generated/api-schema.ts --alphabetize",
    "api:contract:check": "pnpm api:contract:generate && git diff --exit-code -- packages/api-contract/openapi.json apps/web/src/generated/api-schema.ts",
    "verify": "pnpm api:contract:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:api:integration && pnpm test:api:security-integration && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0"
  }
}
